# PRAMAAN-AI Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env to version control.
PROJECT_NAME="PRAMAAN-AI"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
IS_DEMO_MODE=true
PRAMAAN_STORAGE_DIR="storage/uploads"
MIN_OCR_CONFIDENCE_THRESHOLD=0.65

# Set to persist applications, review runs and the audit ledger across restarts (empty = in-memory)
PRAMAAN_DATA_DIR="data"
